[Unit]
Description=RZ/V2H autonomous camera+AI video/detection link -- TX supervisor
# Start as soon as the multi-user system is up. The supervisor has its own
# WAIT_NIC loop, so it tolerates the wlx USB dongle appearing late -- it just
# sits in WAIT_NIC until the NIC has an IP, then becomes DISCOVERABLE.
After=network.target
Wants=network.target

[Service]
Type=simple
# Needs root for SO_BINDTODEVICE on the wlx NIC and for the camera/engine.
User=root
# Deployed location on the board:
WorkingDirectory=/home/ubuntu/stream_release/TX
ExecStart=/usr/bin/python3 /home/ubuntu/stream_release/TX/board_tx.py
# Keep it alive no matter what: if the supervisor itself ever dies, restart.
Restart=always
RestartSec=3
# Don't kill the whole process group on stop -- the supervisor cleans up its
# own engine child via the tracked PID. Send SIGTERM to the python only.
KillMode=mixed
TimeoutStopSec=15
StandardOutput=append:/home/ubuntu/stream_release/TX/logs/board_tx.service.log
StandardError=append:/home/ubuntu/stream_release/TX/logs/board_tx.service.log

[Install]
WantedBy=multi-user.target
